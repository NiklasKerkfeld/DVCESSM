# dataset properties
N_CLASSES=10
IN_CHANNELS=1
IN_WIDTH=32
IN_HEIGHT=32

# parameter
BATCH_SIZE=128
EPOCHS=15# for training the classisifer
ITERATIONS=30# number of iterations
ALPHA=1.0# weight for discriminator loss
BETA=20.0# weight for regulaziatzion
LR_DISC=4e-4#learning rate for discriminatior
LR_GEN=1e-4#learning rate for generator

STD_CLS=0.1#std of noise augmentation (classifier training)
P_CLS=0.1#probablity for salt and peper noise augmentation (classifier training)
B_CLS=0.2#probability of applying augmentation of removing image parts (classifier training)
B_H_MAX_CLS=10#max height of removed part
B_W_MAX_CLS=10#max width of removed part

STD_DISC=0.15#std of noise augmentation (discrimiator training)
P_DISC=0.15#probablity for salt and peper noise augmentation (discrimiator training)
B_DISC=0.0#probability of applying augmentation of removing image parts (discrimiator training)
B_H_MAX_DISC=0#max height of removed part
B_W_MAX_DICS=0#max width of removed part